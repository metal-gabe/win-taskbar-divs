<?xml version="1.0" encoding="utf-8"?>
<Configuration>
   <ViewDefinitions>
      <View>
         <Name>WinTaskbarDivs.Divider</Name>
         <ViewSelectedBy>
            <TypeName>WinTaskbarDivs.Divider</TypeName>
         </ViewSelectedBy>
         <TableControl>
            <TableHeaders>
               <TableColumnHeader><Label>Id</Label></TableColumnHeader>
               <TableColumnHeader><Label>Color</Label></TableColumnHeader>
               <TableColumnHeader><Label>Overlay</Label></TableColumnHeader>
               <TableColumnHeader><Label>Placement</Label></TableColumnHeader>
               <TableColumnHeader><Label>Tooltip</Label></TableColumnHeader>
               <TableColumnHeader><Label>Pinned</Label></TableColumnHeader>
            </TableHeaders>
            <TableRowEntries>
               <TableRowEntry>
                  <TableColumnItems>
                     <TableColumnItem><PropertyName>Id</PropertyName></TableColumnItem>
                     <TableColumnItem><PropertyName>Color</PropertyName></TableColumnItem>
                     <TableColumnItem><PropertyName>Overlay</PropertyName></TableColumnItem>
                     <TableColumnItem><PropertyName>Placement</PropertyName></TableColumnItem>
                     <TableColumnItem><ScriptBlock>if ($_.Tooltip) { $_.Tooltip } else { '(none)' }</ScriptBlock></TableColumnItem>
                     <TableColumnItem><PropertyName>Pinned</PropertyName></TableColumnItem>
                  </TableColumnItems>
               </TableRowEntry>
            </TableRowEntries>
         </TableControl>
      </View>
   </ViewDefinitions>
</Configuration>
